---
import ProjectCard from './ProjectCard.astro';
import { siteConfig } from '../config/site';

const manualProjects = siteConfig.manualProjects ?? [];
---

<section id="projects" class="section">
  <div class="container">
    <h2>Projects</h2>
    <p class="muted">A selection of featured work and recent repositories.</p>

    {manualProjects.length > 0 ? (
      <>
        <h3 class="subsection-title">Featured Projects</h3>
        <div class="projects-grid">
          {manualProjects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              tags={project.tags}
              repoUrl={project.repoUrl}
              demoUrl={project.demoUrl}
              image={project.image}
              featured={project.featured}
            />
          ))}
        </div>
      </>
    ) : (
      <p class="muted empty-state">No featured projects yet. Add entries to <code>src/config/site.ts</code>.</p>
    )}

    <div class="github-projects" id="github-projects">
      <h3 class="subsection-title">From GitHub</h3>
      <p class="muted small">
        Pinned repositories for <strong>{siteConfig.githubUsername}</strong> (fetched live from GitHub API).
      </p>
      <div class="projects-grid" id="github-projects-grid">
        <p class="muted" id="github-status">Loading repositories…</p>
      </div>
    </div>

    <script is:inline define:vars={{ username: siteConfig.githubUsername, pinnedRepos: siteConfig.githubPinnedRepos, manualUrls: siteConfig.manualProjects.map((p) => p.repoUrl).filter(Boolean) }}>
      (function () {
        const statusEl = document.getElementById('github-status');
        const gridEl = document.getElementById('github-projects-grid');
        if (!statusEl || !gridEl) return;

        const escapeHtml = (value) =>
          String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');

        const formatDate = (iso) => {
          if (!iso) return '';
          try {
            return new Date(iso).toLocaleDateString(undefined, { year: 'numeric', month: 'short' });
          } catch {
            return '';
          }
        };

        const renderCard = (repo) => {
          const tags = [repo.language].filter(Boolean);
          const tagsHtml = tags.map((t) => `<li>${escapeHtml(t)}</li>`).join('');
          return `
            <article class="project-card card">
              <div class="project-body">
                <div class="project-header">
                  <h3>${escapeHtml(repo.name)}</h3>
                </div>
                <p class="project-desc">${escapeHtml(repo.description || 'No description provided.')}</p>
                ${tagsHtml ? `<ul class="project-tags" aria-label="Technologies">${tagsHtml}</ul>` : ''}
                <p class="project-meta muted small">
                  <span>★ ${repo.stargazers_count ?? 0}</span>
                  ${repo.updated_at ? `<span>Updated ${escapeHtml(formatDate(repo.updated_at))}</span>` : ''}
                </p>
                <div class="project-actions">
                  <a class="btn btn-secondary" href="${escapeHtml(repo.html_url)}" target="_blank" rel="noopener noreferrer">View Code</a>
                  ${repo.homepage ? `<a class="btn btn-primary" href="${escapeHtml(repo.homepage)}" target="_blank" rel="noopener noreferrer">Live Demo</a>` : ''}
                </div>
              </div>
            </article>
          `;
        };

        const setStatus = (html) => {
          gridEl.innerHTML = `<p class="muted" id="github-status">${html}</p>`;
        };

        if (!Array.isArray(pinnedRepos) || pinnedRepos.length === 0) {
          setStatus('No pinned repositories configured.');
          return;
        }

        const fetchRepo = (name) =>
          fetch(`https://api.github.com/repos/${encodeURIComponent(username)}/${encodeURIComponent(name)}`, {
            headers: { Accept: 'application/vnd.github+json' },
          }).then(async (res) => {
            if (res.status === 403) {
              const remaining = res.headers.get('X-RateLimit-Remaining');
              if (remaining === '0') throw new Error('rate-limit');
            }
            if (res.status === 404) throw new Error('http-404');
            if (!res.ok) throw new Error(`http-${res.status}`);
            return res.json();
          });

        Promise.allSettled(pinnedRepos.map(fetchRepo))
          .then((results) => {
            const repos = results
              .filter((r) => r.status === 'fulfilled' && r.value)
              .map((r) => r.value)
              .filter((r) => !r.fork && !r.archived && !r.private);

            if (repos.length === 0) {
              setStatus('No pinned repositories found.');
              return;
            }

            gridEl.innerHTML = repos.map(renderCard).join('');
          })
          .catch((err) => {
            const msg = String(err && err.message ? err.message : err);
            if (msg === 'rate-limit') {
              setStatus('GitHub API rate limit reached. Please try again later.');
            } else if (msg === 'http-404') {
              setStatus('One or more repositories not found.');
            } else {
              setStatus('Unable to load repositories right now. Please try again later.');
            }
          });
      })();
    </script>
  </div>
</section>

<style>
  .subsection-title {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 720px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .empty-state {
    padding: var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .small {
    font-size: 0.9rem;
  }
</style>
