---
import BaseLayout from '../layouts/BaseLayout.astro';
import Projects from '../components/Projects.astro';
import { siteConfig } from '../config/site';

const title = `${siteConfig.name} – Portfolio`;
const description = siteConfig.tagline;
---

<BaseLayout title={title} description={description}>
  <section id="hero" class="section hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Hello, I'm</p>
        <h1>{siteConfig.name}</h1>
        <p class="role">{siteConfig.role}</p>
        <p class="intro">{siteConfig.bio}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#projects">View Projects</a>
          <a class="btn btn-secondary" href="#contact">Get in Touch</a>
        </div>
        <ul class="hero-social" aria-label="Social links">
          {siteConfig.socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="avatar-placeholder">
          <span>{siteConfig.name.charAt(0).toUpperCase()}</span>
        </div>
      </div>
    </div>
  </section>

  <Projects />

  <section id="about" class="section">
    <div class="container">
      <h2>About</h2>
      <div class="about-grid">
        <div class="about-bio">
          <p>{siteConfig.about}</p>
          <p class="muted">
            This is placeholder content. Replace it with your own story, the projects you're proud of, and what you're looking for next.
          </p>
        </div>
        <div class="about-skills">
          <h3>Skills &amp; Technologies</h3>
          <ul class="skill-list" aria-label="Skills">
            {siteConfig.skills.map((skill) => (
              <li class="skill-tag">{skill}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="about-highlights">
        <div class="card">
          <h3>Experience</h3>
          <p class="muted">
            Placeholder: Add a short summary of your work experience, roles, or internships. Link to a resume if you have one.
          </p>
        </div>
        <div class="card">
          <h3>Education</h3>
          <p class="muted">
            Placeholder: Add your degree, institution, or relevant coursework/certifications.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container">
      <h2>Contact</h2>
      <p class="muted">
        Have a question or want to work together? Send a message and I'll get back to you.
      </p>

      <div class="contact-grid">
        <div class="contact-info card">
          <h3>Get in touch</h3>
          <p>
            <a class="btn btn-primary" href={`mailto:${siteConfig.contactEmail}?subject=Hello%20from%20your%20portfolio`}>
              Email me
            </a>
          </p>
          <p class="muted small">
            Or reach out directly at
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.
          </p>

          <h3 class="contact-social-heading">Elsewhere</h3>
          <ul class="contact-social" aria-label="Social links">
            {siteConfig.socialLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <form class="contact-form card" action={`mailto:${siteConfig.contactEmail}`} method="post" enctype="text/plain">
          <h3>Send a message</h3>
          <p class="muted small">This form opens your email client (no backend required).</p>
          <label>
            <span>Name</span>
            <input type="text" name="name" placeholder="Your name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" placeholder="you@example.com" required />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="5" placeholder="Your message" required></textarea>
          </label>
          <button type="submit" class="btn btn-primary">Send</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 var(--space-2);
    line-height: 1.1;
  }
  .role {
    font-size: 1.375rem;
    color: var(--color-muted);
    margin: 0 0 var(--space-4);
  }
  .intro {
    max-width: 60ch;
    margin: 0 0 var(--space-6);
    font-size: 1.05rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .hero-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .hero-social a {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .hero-social a:hover {
    color: var(--color-primary);
  }
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .avatar-placeholder {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), #9333ea);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 5rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }
  .muted {
    color: var(--color-muted);
  }
  h2 {
    margin-top: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .about-bio p {
    margin-bottom: var(--space-4);
  }
  .about-skills h3,
  .about-highlights h3 {
    margin-top: 0;
  }
  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .skill-tag {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .about-highlights {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 720px) {
    .about-highlights {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact-social-heading {
    margin-top: var(--space-6);
  }
  .contact-social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact-social a {
    color: var(--color-primary);
  }
  .contact-form label {
    display: block;
    margin-bottom: var(--space-4);
  }
  .contact-form label span {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }
  .small {
    font-size: 0.9rem;
  }
</style>
